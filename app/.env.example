# AlphaCore — environment configuration
# Copy to .env and fill in what you have. Any provider without a key is
# simply unavailable; with NO keys at all the router runs in mock mode so
# the whole platform is demoable at zero cost.

# --- Server ---
PORT=8484

# --- Anthropic (Claude API) ---
ANTHROPIC_API_KEY=

# --- Claude subscription (Claude Code CLI) ---
# Uses your logged-in claude.ai Pro/Max subscription via the `claude` CLI
# instead of (or alongside) the metered API. Zero marginal cash cost.
CLAUDE_CLI_ENABLED=true
# Optional: absolute path to the CLI when it is not on PATH.
# Windows installs usually land in %USERPROFILE%\.local\bin\claude.exe
CLAUDE_CLI_PATH=

# --- OpenAI (ChatGPT models) ---
OPENAI_API_KEY=

# --- DeepSeek ---
DEEPSEEK_API_KEY=

# --- Google (Gemini) ---
GEMINI_API_KEY=

# --- Safety ---
# Force mock mode even if keys are present (useful for demos/tests)
ALPHACORE_MOCK=false
