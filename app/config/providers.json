{
  "_note": "Prices are USD per 1M tokens [in, out], entered 2026-08 — verify against provider pricing pages before production (Part 6 §1.2: no benchmark laundering; reforecast monthly). Model changes are T2 decisions requiring green regression evals (ADR-005).",
  "providers": {
    "anthropic": {
      "family": "anthropic",
      "kind": "anthropic",
      "keyEnv": "ANTHROPIC_API_KEY",
      "dpa": true,
      "noTraining": true,
      "models": {
        "claude-opus-5":   { "priceIn": 5.0,  "priceOut": 25.0 },
        "claude-sonnet-5": { "priceIn": 3.0,  "priceOut": 15.0 },
        "claude-haiku-4-5": { "priceIn": 1.0, "priceOut": 5.0 }
      }
    },
    "claude-subscription": {
      "family": "anthropic",
      "kind": "claude-cli",
      "keyEnv": null,
      "enabledEnv": "CLAUDE_CLI_ENABLED",
      "dpa": true,
      "noTraining": true,
      "_note": "Claude Pro/Max subscription via the Claude Code CLI (`claude -p --model <alias>`). Zero marginal cash cost; usage metered in tokens against the plan's 5-hour windows. Same model family as `anthropic` — never pair as an independent reviewer against it.",
      "models": {
        "cli-default": { "priceIn": 0, "priceOut": 0 },
        "haiku":  { "priceIn": 0, "priceOut": 0 },
        "sonnet": { "priceIn": 0, "priceOut": 0 },
        "opus":   { "priceIn": 0, "priceOut": 0 }
      }
    },
    "openai": {
      "family": "openai",
      "kind": "openai-compat",
      "baseUrl": "https://api.openai.com/v1",
      "keyEnv": "OPENAI_API_KEY",
      "dpa": true,
      "noTraining": true,
      "models": {
        "gpt-5.1":    { "priceIn": 1.25, "priceOut": 10.0 },
        "gpt-5-mini": { "priceIn": 0.25, "priceOut": 2.0 }
      }
    },
    "deepseek": {
      "family": "deepseek",
      "kind": "openai-compat",
      "baseUrl": "https://api.deepseek.com/v1",
      "keyEnv": "DEEPSEEK_API_KEY",
      "dpa": false,
      "noTraining": false,
      "_note": "No DPA/no-training posture assumed — sensitivity router therefore never sends customer_min data here (Part 3 §7.5).",
      "models": {
        "deepseek-chat":     { "priceIn": 0.28, "priceOut": 0.42 },
        "deepseek-reasoner": { "priceIn": 0.28, "priceOut": 0.42 }
      }
    },
    "google": {
      "family": "google",
      "kind": "gemini",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "keyEnv": "GEMINI_API_KEY",
      "dpa": true,
      "noTraining": true,
      "models": {
        "gemini-3-pro-preview": { "priceIn": 2.0, "priceOut": 12.0 },
        "gemini-2.5-flash":     { "priceIn": 0.3, "priceOut": 2.5 }
      }
    },
    "openrouter": {
      "family": "openrouter",
      "kind": "openai-compat",
      "baseUrl": "https://openrouter.ai/api/v1",
      "keyEnv": "OPENROUTER_API_KEY",
      "dpa": false,
      "noTraining": false,
      "_note": "An aggregator in front of many families. Treated as its own family for reviewer independence: two OpenRouter calls may land on the same underlying model, so they never count as two opinions.",
      "models": {
        "anthropic/claude-sonnet-4.5": { "priceIn": 3.0, "priceOut": 15.0 },
        "meta-llama/llama-3.3-70b-instruct": { "priceIn": 0.12, "priceOut": 0.3 },
        "qwen/qwen-2.5-72b-instruct": { "priceIn": 0.12, "priceOut": 0.39 }
      }
    },
    "groq": {
      "family": "groq",
      "kind": "openai-compat",
      "baseUrl": "https://api.groq.com/openai/v1",
      "keyEnv": "GROQ_API_KEY",
      "dpa": false,
      "noTraining": false,
      "_note": "Very fast, very cheap; used for triage volume where latency matters more than depth.",
      "models": {
        "llama-3.3-70b-versatile": { "priceIn": 0.59, "priceOut": 0.79 },
        "llama-3.1-8b-instant": { "priceIn": 0.05, "priceOut": 0.08 }
      }
    },
    "together": {
      "family": "together",
      "kind": "openai-compat",
      "baseUrl": "https://api.together.xyz/v1",
      "keyEnv": "TOGETHER_API_KEY",
      "dpa": false,
      "noTraining": false,
      "models": {
        "meta-llama/Llama-3.3-70B-Instruct-Turbo": { "priceIn": 0.88, "priceOut": 0.88 },
        "Qwen/Qwen2.5-72B-Instruct-Turbo": { "priceIn": 1.2, "priceOut": 1.2 }
      }
    },
    "ollama": {
      "family": "local",
      "kind": "openai-compat",
      "baseUrl": "http://127.0.0.1:11434/v1",
      "keyEnv": "OLLAMA_ENABLED",
      "dpa": true,
      "noTraining": true,
      "_note": "Sovereign mode. The model runs on this machine, so nothing leaves it and the price is electricity. This is the only provider that keeps working with the internet cut, which in Iraq is the difference between a company that runs and one that waits. Because the data never leaves, it is cleared for every sensitivity level.",
      "models": {
        "qwen2.5:14b": { "priceIn": 0, "priceOut": 0 },
        "llama3.1:8b": { "priceIn": 0, "priceOut": 0 },
        "gemma2:9b": { "priceIn": 0, "priceOut": 0 }
      }
    },
    "mock": {
      "family": "mock",
      "kind": "mock",
      "keyEnv": null,
      "dpa": true,
      "noTraining": true,
      "models": { "mock-small": { "priceIn": 0, "priceOut": 0 }, "mock-large": { "priceIn": 0, "priceOut": 0 } }
    }
  },
  "tiers": {
    "T1": {
      "purpose": "Classification, extraction, triage",
      "chain": [
        { "provider": "claude-subscription", "model": "haiku" },
        { "provider": "anthropic", "model": "claude-haiku-4-5" },
        { "provider": "google", "model": "gemini-2.5-flash" },
        { "provider": "groq", "model": "llama-3.1-8b-instant" },
        { "provider": "deepseek", "model": "deepseek-chat" },
        { "provider": "ollama", "model": "llama3.1:8b" }
      ],
      "onExhausted": "queue"
    },
    "T2": {
      "purpose": "Drafting and analysis",
      "chain": [
        { "provider": "claude-subscription", "model": "sonnet" },
        { "provider": "anthropic", "model": "claude-sonnet-5" },
        { "provider": "claude-subscription", "model": "haiku" },
        { "provider": "openai", "model": "gpt-5-mini" },
        { "provider": "deepseek", "model": "deepseek-chat" },
        { "provider": "openrouter", "model": "qwen/qwen-2.5-72b-instruct" },
        { "provider": "ollama", "model": "qwen2.5:14b" }
      ],
      "onExhausted": "degrade-T1-with-flag"
    },
    "T3": {
      "purpose": "Reasoning, architecture, coding",
      "_note": "Sonnet on the subscription sits between the Opus attempts and the external families: when an Opus window is exhausted, degrading within the subscription is far better than stopping the company, and the serving model is recorded on every run so the degrade is visible rather than silent.",
      "chain": [
        { "provider": "claude-subscription", "model": "opus" },
        { "provider": "anthropic", "model": "claude-opus-5" },
        { "provider": "claude-subscription", "model": "sonnet" },
        { "provider": "openai", "model": "gpt-5.1" },
        { "provider": "google", "model": "gemini-3-pro-preview" },
        { "provider": "deepseek", "model": "deepseek-reasoner" }
      ],
      "_lastResort": "deepseek-reasoner sits at the end so an install whose only key is DeepSeek still has a reasoning tier rather than a company that stops. It is last for a reason: no DPA and no no-training guarantee, so the sensitivity map keeps customer_min and restricted work away from it regardless of this chain.",
      "onExhausted": "stop-human"
    },
    "T4": {
      "purpose": "Critical cross-check — two independent families in parallel; disagreement goes to a human. Fail closed.",
      "pair": [
        { "provider": "anthropic", "model": "claude-opus-5" },
        { "provider": "openai", "model": "gpt-5.1" }
      ],
      "pairFallback": [
        { "provider": "anthropic", "model": "claude-opus-5" },
        { "provider": "google", "model": "gemini-3-pro-preview" }
      ],
      "onExhausted": "fail-closed"
    }
  },
  "sensitivity": {
    "_note": "Part 3 §7.5 — customer_min payloads may only reach providers with dpa AND noTraining; restricted content never enters model context at all.",
    "public": ["anthropic", "claude-subscription", "openai", "deepseek", "google", "openrouter", "groq", "together", "ollama", "mock"],
    "internal": ["anthropic", "claude-subscription", "openai", "deepseek", "google", "groq", "ollama", "mock"],
    "customer_min": ["anthropic", "claude-subscription", "openai", "google", "ollama", "mock"],
    "restricted": ["ollama"]
  }
}
