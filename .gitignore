node_modules/

# Nothing a running company produces belongs in the platform's repository.
#
# `data/` holds the database and `master.key` — the AES key that decrypts every
# credential in the vault. `workspace/` holds the documents the workforce wrote:
# blueprints, financial reports, intelligence exports, customer names. Both are
# regenerated by the platform and both are yours, not the project's.
#
# The rule is the directory, not a glob inside it: `data/*.db` is single-level
# and would not have matched `data/simulations/sim-1.db`, a complete fork of the
# company database, or `data/master.key` at all.
data/
crucible-core/data/
crucible-core/workspace/

# Backups, wherever somebody puts them.
*-backup-*/
backups/

# Secrets, wherever they land.
.env
.env.*
!.env.example
*.key
*.pem
master.key
