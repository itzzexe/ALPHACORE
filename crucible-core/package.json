{
  "name": "alphacore",
  "version": "0.1.0",
  "description": "AlphaCore — the internal operating platform for an AI-native SaaS company (Part 3 of the AlphaCore blueprint). Modular monolith: decision registry, budgets, multi-provider model router, run queue, mini-tribunal, hash-chained audit log, admin dashboard.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --experimental-sqlite src/server.js",
    "dev": "node --experimental-sqlite --watch src/server.js",
    "seed": "node --experimental-sqlite scripts/seed.js",
    "test": "node --experimental-sqlite --test test/smoke.test.js test/world.test.js test/platform.test.js",
    "prove": "node --experimental-sqlite scripts/prove-world.mjs",
    "prove:platform": "node --experimental-sqlite scripts/prove-platform.mjs",
    "reset-password": "node --experimental-sqlite scripts/reset-password.mjs",
    "icons": "node --experimental-sqlite scripts/make-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0"
  }
}
